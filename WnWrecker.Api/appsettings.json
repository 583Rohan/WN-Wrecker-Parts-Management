{
  // PostgreSQL (Neon) connection — never put the real one here.
  // Local: User Secrets "ConnectionStrings:DefaultConnection". Hosted: env var "ConnectionStrings__DefaultConnection".
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  // Admin Authentication
  "Jwt": { "Issuer": "WnWreckerApi" },
  "AdminCredentials": { "Username": "admin" },

  // ONE place for the business details — used by the website (contact page, footer, chat),
  // the chat bot's answers, invoice PDFs and chat transcripts.
  // PLACEHOLDERS: replace with the client's real details.
  "Business": {
    "Name": "WN Wrecker",
    "Abn": "00 000 000 000",
    "Address": "[Street address, Suburb STATE 0000]",
    "Phone": "[phone]",
    "Email": "[email]",
    "Hours": "Mon–Fri 8am–5pm · Sat 9am–1pm · Closed Sundays and public holidays",
    "PaymentInfo": "Bank transfer: [Account name] · BSB [000-000] · Acc [00000000] · Use the invoice number as reference.",
    "InvoiceFooter": "Thank you for your business — WN Wrecker"
  },

  // Website addresses allowed to call the API (add the hosted site's address here when it goes live)
  "Cors": { "Origins": [ "http://localhost:5173" ] },

  // Old chats are deleted automatically
  "ChatCleanup": { "ClosedChatDays": 7, "InactiveChatDays": 60 },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
